# ====================================================================
# CLASSICAL DECOR I D (DST DECO) - PRODUCTION ENVIRONMENT (.env.example)
# ====================================================================
# Copy this file to `.env` before running: cp .env.example .env

PORT=5000
NODE_ENV=development

# --------------------------------------------------------------------
# 1. MONGODB ATLAS CONFIGURATION
# --------------------------------------------------------------------
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/dst_deco?retryWrites=true&w=majority

# --------------------------------------------------------------------
# 2. JWT & ADMIN DASHBOARD SECURITY
# Generate a 64-byte secret in Git Bash:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# --------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX_SECRET
ADMIN_EMAIL=d@gmail.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# --------------------------------------------------------------------
# 3. CLOUDINARY 1-CLICK IMAGE CDN CONFIGURATION
# Create account at https://cloudinary.com -> Dashboard -> Copy keys:
# Run `npm run sync:cloudinary` to auto-upload all categorized images!
# --------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --------------------------------------------------------------------
# 4. GOOGLE SHEETS LEAD CAPTURE WEBHOOK (Apps Script)
# Paste Web App URL from `google-sheets-script/Code.gs` deployment
# --------------------------------------------------------------------
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_SHEETS_SECRET_TOKEN=REPLACE_WITH_SHARED_SECRET_MATCHING_CODE_GS

# --------------------------------------------------------------------
# 5. OFFICIAL CLIENT INFO (FROM BUSINESS CARD) - PUBLIC NEXT.JS VARS
# --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://dstdeco.com
NEXT_PUBLIC_BRAND_NAME="CLASSICAL DECOR I D"
NEXT_PUBLIC_BRAND_SUBTITLE="DST Deco"
NEXT_PUBLIC_BRAND_TAGLINE="DESIGN • DECOR • PERFECT"
NEXT_PUBLIC_WHATSAPP_NUMBER=971543532585
NEXT_PUBLIC_PHONE_DISPLAY="+971 543 532 585"
NEXT_PUBLIC_CLIENT_EMAIL="dstdeco@gmail.com"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/classicaldecorid"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/classicaldecorid"
